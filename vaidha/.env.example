# ==============================================================================
# Vaidha Mobile App - Environment Configuration Template
# ==============================================================================
# The Vaidha mobile app connects securely to the UrbanFarm backend.
# All AI Vision & Pathology processing (Groq Vision / Gemini Vision) is handled
# server-side by the backend, so NO Gemini API key is exposed in the app.
#
# Flutter Run / Build usage:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
# ==============================================================================

# Backend API Base URL
# - Android Emulator (Development): http://10.0.2.2:5000
# - Local Web / Desktop: http://localhost:5000
# - Production Server: https://urbanfarm-server.vercel.app
API_BASE_URL=http://10.0.2.2:5000

# Optional Direct Gemini API Key (Only needed for standalone offline testing without any backend)
# GEMINI_API_KEY=
