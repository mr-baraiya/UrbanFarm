# ==============================================================================
# Vaidha Mobile App - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your .env file containing private API keys into Git.
#
# Flutter Build / Run usage:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
# ==============================================================================

# Google Gemini Vision API Key (Required for standalone offline AI diagnosis mode)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API Base URL (Optional: used if routing through the UrbanFarm backend server)
# Local development emulator: http://10.0.2.2:5000
# Local web / desktop: http://localhost:5000
# Production server: https://urbanfarm-server.vercel.app
API_BASE_URL=https://urbanfarm-server.vercel.app
