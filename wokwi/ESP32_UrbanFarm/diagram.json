{
  "version": 1,
  "author": "UrbanFarm IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -120, "left": -120, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 150, "left": -120, "attrs": { "label": "Soil Moisture" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 150, "left": 150, "attrs": { "label": "Light LDR" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "dht1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht1:VCC", "red", [ "v0" ] ],
    [ "esp:15", "dht1:SDA", "green", [ "v0" ] ],
    [ "esp:GND.2", "pot1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "pot1:VCC", "red", [ "v0" ] ],
    [ "esp:34", "pot1:SIG", "blue", [ "v0" ] ],
    [ "esp:GND.3", "ldr1:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "ldr1:VCC", "red", [ "v0" ] ],
    [ "esp:35", "ldr1:AO", "orange", [ "v0" ] ]
  ]
}
